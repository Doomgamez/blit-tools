{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "BlitScript",
    "scopeName": "source.blitscript",
    "patterns": [
        { "include": "#comment" },
        { "include": "#include" },
        { "include": "#main" },
        { "include": "#label" },
        { "include": "#jump" },
        { "include": "#function" },
        { "include": "#constant-definition" },
        { "include": "#call" },
        { "include": "#instruction" },
        { "include": "#values" }
    ],
    "repository": {
        "comment": {
            "name": "comment.line.double-slash.blitscript",
            "match": "//.*$"
        },
        "string": {
            "name": "string.quoted.double.blitscript",
            "begin": "\"",
            "end": "\"|$",
            "patterns": [
                { "name": "constant.character.escape.blitscript", "match": "\\\\[nrt\\\\\"]" },
                { "name": "constant.other.placeholder.blitscript", "match": "%[-+0-9.]*[dfsxXug]" }
            ]
        },
        "include": {
            "match": "(?i)^\\s*(INCLUDE)\\b",
            "captures": { "1": { "name": "keyword.control.import.blitscript" } }
        },
        "main": {
            "match": "(?i)^\\s*(MAIN)\\s+(LBL)\\s+([^\\s,/]+)",
            "captures": {
                "1": { "name": "keyword.control.blitscript" },
                "2": { "name": "keyword.control.blitscript" },
                "3": { "name": "entity.name.function.blitscript" }
            }
        },
        "label": {
            "match": "(?i)^\\s*(LBL)\\s+([^\\s,/]+)",
            "captures": {
                "1": { "name": "keyword.control.blitscript" },
                "2": { "name": "entity.name.label.blitscript" }
            }
        },
        "jump": {
            "match": "(?i)^\\s*(JMP|JZ|JE|JNE|JS|JNS|JG|JGE|JL|JLE|JA|JAE|JB|JBE)\\s+([^\\s,/]+)",
            "captures": {
                "1": { "name": "keyword.control.flow.blitscript" },
                "2": { "name": "entity.name.label.blitscript" }
            }
        },
        "function": {
            "begin": "(?i)^\\s*(FN)\\s+([^\\s,/]+)",
            "beginCaptures": {
                "1": { "name": "storage.type.function.blitscript" },
                "2": { "name": "entity.name.function.blitscript" }
            },
            "end": "$|(?=//)",
            "patterns": [
                { "name": "variable.parameter.blitscript", "match": "[^\\s,/]+" }
            ]
        },
        "constant-definition": {
            "match": "(?i)^\\s*(CONST)\\s+([^\\s,/]+)",
            "captures": {
                "1": { "name": "storage.modifier.blitscript" },
                "2": { "name": "variable.other.constant.blitscript" }
            }
        },
        "call": {
            "match": "(?i)^\\s*(CALL)\\s+([^\\s,/]+)",
            "captures": {
                "1": { "name": "keyword.control.blitscript" },
                "2": { "name": "entity.name.function.blitscript" }
            }
        },
        "instruction": {
            "patterns": [
                { "name": "keyword.control.blitscript", "match": "(?i)^\\s*(END|RET)\\b" },
                {
                    "match": "(?i)^\\s*(FOR|FOREACH)\\s+([^\\s,/]+)",
                    "captures": {
                        "1": { "name": "keyword.control.flow.blitscript" },
                        "2": { "name": "variable.other.blitscript" }
                    }
                },
                { "name": "keyword.control.flow.blitscript", "match": "(?i)^\\s*(ENDFOR|BREAK|CONTINUE)\\b" },
                {
                    "match": "(?i)^\\s*(SET|LOCAL|READ|MOV)\\s+([^\\s,/]+)",
                    "captures": {
                        "1": { "name": "keyword.other.blitscript" },
                        "2": { "name": "variable.other.blitscript" }
                    }
                },
                { "name": "keyword.operator.arithmetic.blitscript", "match": "(?i)^\\s*(ADD|SUB|MUL|DIV|MOD)\\b" },
                { "name": "keyword.other.blitscript", "match": "(?i)^\\s*CMP\\b" }
            ]
        },
        "values": {
            "patterns": [
                { "include": "#string" },
                { "name": "keyword.operator.arrow.blitscript", "match": "->" },
                { "name": "storage.type.blitscript", "match": "(?i)\\b(VEC[234]|IVEC[234]|UVEC[234]|QUAT|RECT|COLOR|MAT4)\\b" },
                { "name": "variable.language.register.blitscript", "match": "(?i)\\b(EAX|EBX|ECX|EDX)\\b" },
                { "name": "constant.language.blitscript", "match": "\\b(true|false|null)\\b" },
                { "name": "constant.numeric.hex.blitscript", "match": "(?i)(?<![\\w.])[+-]?0x[0-9a-f]+(u64|i64|u)?\\b" },
                { "name": "constant.numeric.blitscript", "match": "(?i)(?<![\\w.])[+-]?(\\d+\\.?\\d*|\\.\\d+)(e[+-]?\\d+)?(u64|i64|u|f|d)?\\b" },
                { "name": "variable.other.constant.blitscript", "match": "\\b[A-Z][A-Z0-9_]+\\b" },
                { "name": "variable.other.blitscript", "match": "[A-Za-z_][A-Za-z0-9_]*" }
            ]
        }
    }
}
