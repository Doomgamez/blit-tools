{
    "Program": {
        "prefix": "main",
        "description": "A script with a frame loop",
        "body": [
            "INCLUDE \"engine.bs\"",
            "",
            "MAIN LBL main",
            "",
            "LBL frame",
            "    ClearBackground(BLACK)",
            "    $0",
            "    WaitFrame()",
            "    JMP frame",
            "",
            "END"
        ]
    },
    "Function": {
        "prefix": "fn",
        "description": "A script function",
        "body": [
            "FN ${1:name} ${2:params}",
            "    $0",
            "END"
        ]
    },
    "3D block": {
        "prefix": "mode3d",
        "description": "Draw through a 3D camera",
        "body": [
            "CALL BeginMode3D ${1:camera}",
            "    $0",
            "CALL EndMode3D"
        ]
    },
    "Scene": {
        "prefix": "scene",
        "description": "Load a glTF level and a camera",
        "body": [
            "CALL CreateCamera3D VEC3 0 1.6 5, VEC3 0 1.6 0, 60 -> ${1:camera}",
            "CALL LoadScene \"${2:level.glb}\" -> ${3:scene}",
            "$0"
        ]
    },
    "Level": {
        "prefix": "level",
        "description": "Load the level the game was started on (the scene, or the editor's Play), start at its info_player_start, spawn its scripted objects. Needs INCLUDE \"level.bs\"",
        "body": [
            "${2:level} = LoadLevel(LaunchLevelOr(\"${1:main.blvl}\"))",
            "${3:scene} = GetLevelScene($2)",
            "${4:objects} = SpawnLevelObjects($2)",
            "start = GetEntityPosition($2, FindLevelEntity($2, \"info_player_start\", 0))",
            "CALL CreateCamera3D start, VEC3 0 0 -10, 60 -> ${5:camera}",
            "$0"
        ]
    },
    "Level object": {
        "prefix": "levelobject",
        "description": "A class an entity's \"script\" property can name. Needs INCLUDE \"level.bs\"",
        "body": [
            "CLASS ${1:Name} EXTENDS LevelObject",
            "    FIELD ${2:speed} 1.0",
            "",
            "    // once, after level, scene, entity, name and node are set",
            "    METHOD Spawn",
            "        this.$2 = this.PropertyFloat(\"$2\", 1.0)",
            "    END",
            "",
            "    METHOD Update dt",
            "        $0",
            "    END",
            "",
            "    // a trigger's target, or the player using it",
            "    METHOD Use other",
            "    END",
            "ENDCLASS"
        ]
    },
    "Lighting": {
        "prefix": "lighting",
        "description": "The shadow color (what nothing lights: WHITE no shadow, BLACK pitch black), a sun with shadows, and fog",
        "body": [
            "CALL SetShadowColor COLOR ${1:40 42 55} 255",
            "CALL SetSunLight VEC3 ${2:-0.6 -0.7 -0.4}, COLOR 255 240 220 255, ${3:0.9}",
            "SetShadows(true)",
            "CALL SetFog COLOR ${4:24 26 32} 255, ${5:8} ${6:30}",
            "$0"
        ]
    },
    "Point light": {
        "prefix": "pointlight",
        "description": "A light that fades to nothing at its range",
        "body": [
            "CALL CreatePointLight VEC3 ${1:0 2 0}, COLOR ${2:255 190 110} 255, ${3:6}, ${4:1.0} -> ${5:light}",
            "$0"
        ]
    },
    "Dark": {
        "prefix": "dark",
        "description": "Pitch black except where point lights reach: a black shadow color and no sun",
        "body": [
            "CALL SetShadowColor COLOR ${1:8 8 12} 255",
            "CALL SetSunLight VEC3 0 -1 0, WHITE, 0",
            "$0"
        ]
    },
    "Scenes": {
        "prefix": "scenes",
        "description": "Go to another scene (the level editor's Scenes tab): the main script starts again on its level",
        "body": [
            "IF IsKeyPressed(${1:KEY_N})",
            "    ChangeScene((GetCurrentScene() + 1) % GetSceneCount())",
            "ENDIF",
            "$0"
        ]
    },
    "Level 2D": {
        "prefix": "level2d",
        "description": "A 2D level with its sprites, boxes, texts and camera, drawn in the editor's order. Needs INCLUDE \"level2d.bs\"",
        "body": [
            "level = LoadLevel(LaunchLevelOr(\"${1:main.blvl}\"))",
            "sprites = LoadLevelSprites(level)",
            "walls = LoadLevelBoxes(level, \"solid_2d\")",
            "texts = LoadLevelTexts(level)",
            "camera = LoadLevelCamera(level, true)",
            "",
            "LBL frame",
            "    ClearBackground(BLACK)",
            "    camera.Begin()",
            "        DrawLevelLayers(sprites, walls, GRAY, camera)",
            "        DrawLevelTexts(texts, camera)",
            "    camera.End()",
            "    DrawScreenTexts(texts)",
            "    $0",
            "    WaitFrame()",
            "    JMP frame"
        ]
    }
}
